# 秘密情報（最初のコミットから）
.env
.env.*
!.env.example

# 依存と生成物
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# 評価用のキャッシュ（記事本文はリポジトリに入れない）
eval/.cache/

# 確認依頼のトークンと回答（手元のサーバだけが持つ）
apps/web/.data/

# OS・エディタ
.DS_Store
*.log
.vscode/
.idea/

# ローカルの Claude Code 設定
.claude/settings.local.json
.claude/.cc-writes/

# サンドボックス内で pnpm がプロジェクト内に作るストア
.pnpm-store/
.claude/launch.json

# lego（Let's Encrypt）のアカウント鍵と証明書。絶対にコミットしない
.lego/

# ポータブル ZIP のビルドの出力
dist-zip/
