# Claude API（サーバ側からだけ使う。ブラウザには渡さない）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# メール送信（任意。未設定なら送信箱と mailto リンクだけ）
SMTP_URL=
MAIL_FROM=

# 回答リンクの土台（Cloudflare Tunnel などで手元のサーバを一時公開するときの URL。未設定なら http://localhost:5173）
PUBLIC_BASE_URL=
# 公開 URL 経由（転送ヘッダつき）の要求は、既定では回答ページの API だけに制限する。
# 全 API を公開 URL から使うときだけ 1 にする（会社カルテを扱う API が外から見えるので、デモ以外では設定しない）
UCHIDAI_ALLOW_REMOTE_API=
