{
  "name": "@uchidai/eval",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "専門家の正解データに対する読解・判定の一致度を採点する",
  "scripts": {
    "eval": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/run.ts",
    "eval:attacker": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/attacker-eval.ts",
    "eval:articles": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/articles-eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uchidai/engine": "workspace:*",
    "@uchidai/llm": "workspace:*",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.5"
  }
}
