# ウチダイの設定ファイル（すべて任意）
#
# 使うには、このファイルをコピーして、名前を「uchidai.env」にします。
# 使いたい行の先頭の「# 」を消して、= のあとに値を書いてください。保存して、ウチダイを起動し直すと効きます。
# 値を書いたファイルは、他の人に渡さないでください（API キーは、使った分だけお金がかかる鍵です）。

# 記事の読解と、文章の言い換えを使うときだけ、Anthropic の API キーが要ります。
# 無くても、判定、経路の再生、対策ボタン、記録済みの事例などは使えます。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 会社のプロキシ経由で外に出るとき（例：http://proxy.example.co.jp:8080）
# HTTPS_PROXY=

# 確認依頼をメールで送るとき（無ければ、送信箱と mailto: のリンクだけ使えます）
# SMTP_URL=
# MAIL_FROM=

# 使うポート番号を変えるとき（使用中なら、次の空き番号に自動で移ります）
# API_PORT=8787

# 確認依頼などの保存先を変えるとき（既定は、あなたのユーザー領域の uchidai フォルダ）
# UCHIDAI_DATA_DIR=

# 失敗したときのログに出る記事の URL から、パスとクエリを伏せたいとき（ホスト名だけ残ります。既定は伏せません）
# UCHIDAI_LOG_REDACT_URLS=1
