{
  "name": "@uchidai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "画面（Vite + React）と API（Hono）。Claude API はサーバ側からだけ呼ぶ",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fontsource/biz-udpgothic": "^5.2.0",
    "@fontsource/biz-udpmincho": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@hono/node-server": "^1.19.0",
    "@uchidai/engine": "workspace:*",
    "@uchidai/llm": "workspace:*",
    "hono": "^4.10.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
