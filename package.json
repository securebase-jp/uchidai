{
  "name": "uchidai",
  "private": true,
  "version": "0.0.0",
  "description": "ウチダイ：「うちの会社は大丈夫か？」に根拠つきで答えるサイバー攻撃対策の簡易評価ツール",
  "license": "MIT",
  "author": "ab3xy",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "eval": "pnpm --filter @uchidai/eval run eval",
    "eval:attacker": "pnpm --filter @uchidai/eval run eval:attacker",
    "eval:articles": "pnpm --filter @uchidai/eval run eval:articles",
    "test": "pnpm -r --if-present run test && pnpm run test:portable",
    "test:portable": "node --disable-warning=ExperimentalWarning --test \"scripts/portable/*.test.ts\"",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "secrets": "gitleaks git --no-banner",
    "prepare": "lefthook install",
    "attack:import": "node --disable-warning=ExperimentalWarning scripts/import-attack.ts",
    "knowledge:check": "pnpm --filter @uchidai/engine run knowledge:check",
    "dev": "pnpm --filter @uchidai/web run dev",
    "build": "pnpm --filter @uchidai/web run build",
    "portable:build": "node --disable-warning=ExperimentalWarning scripts/portable/build-zip.ts",
    "portable:smoke": "node --disable-warning=ExperimentalWarning scripts/portable/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "lefthook": "^1.12.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
