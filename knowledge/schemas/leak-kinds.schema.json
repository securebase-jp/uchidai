{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "labelJa": {
            "type": "string"
          },
          "readingHintJa": {
            "type": "string"
          },
          "noteJa": {
            "type": "string"
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "labelJa",
          "readingHintJa",
          "noteJa",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kinds"
  ],
  "additionalProperties": false
}
