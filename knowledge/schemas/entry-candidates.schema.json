{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceJa": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "mirrorUrl": {
      "type": "string"
    },
    "surveyJa": {
      "type": "string"
    },
    "fiveYear": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "candidates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "labelJa": {
            "type": "string"
          },
          "technique": {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          },
          "stat": {
            "type": "object",
            "properties": {
              "categoryJa": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "categoryJa",
              "count",
              "total"
            ],
            "additionalProperties": false
          },
          "noteJa": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "labelJa",
          "technique"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sourceJa",
    "sourceUrl",
    "candidates"
  ],
  "additionalProperties": false
}
