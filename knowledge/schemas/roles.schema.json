{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "labelJa": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "enum": [
              "system",
              "business",
              "management"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "internal",
              "external",
              "person"
            ]
          },
          "descriptionJa": {
            "type": "string"
          },
          "links": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          },
          "attrs": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "boolean",
                    "string",
                    "number"
                  ]
                },
                "descriptionJa": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "descriptionJa"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "labelJa",
          "layer",
          "side",
          "links",
          "attrs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "roles"
  ],
  "additionalProperties": false
}
