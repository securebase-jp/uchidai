{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "modified": {
      "type": "string"
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TA\\d{4}$"
          },
          "name": {
            "type": "string"
          },
          "shortname": {
            "type": "string"
          }
        },
        "required": ["id", "name", "shortname"],
        "additionalProperties": false
      }
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          },
          "name": {
            "type": "string"
          },
          "tactics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TA\\d{4}$"
            }
          },
          "parent": {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          },
          "revoked": {
            "type": "boolean"
          },
          "deprecated": {
            "type": "boolean"
          }
        },
        "required": ["id", "name", "tactics", "revoked", "deprecated"],
        "additionalProperties": false
      }
    },
    "mitigations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(M\\d{4}|UD-\\d{2})$"
          },
          "name": {
            "type": "string"
          },
          "deprecated": {
            "type": "boolean"
          }
        },
        "required": ["id", "name", "deprecated"],
        "additionalProperties": false
      }
    },
    "mitigates": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^(M\\d{4}|UD-\\d{2})$"
          },
          {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "revokedBy": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          },
          {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": [
    "version",
    "modified",
    "tactics",
    "techniques",
    "mitigations",
    "mitigates",
    "revokedBy"
  ],
  "additionalProperties": false
}
