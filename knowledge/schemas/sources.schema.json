{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "titleJa": {
            "type": "string",
            "minLength": 1
          },
          "noteJa": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "titleJa"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "categoryId": {
            "type": "string"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisherJa": {
            "type": "string",
            "minLength": 1
          },
          "licenseJa": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "usedForJa": {
            "type": "string",
            "minLength": 1
          },
          "noticeJa": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoryId",
          "nameJa",
          "url",
          "publisherJa",
          "usedForJa"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "categories",
    "sources"
  ],
  "additionalProperties": false
}
